---
import Arrow from '../components/Arrow.astro';
import MailIllustration from '../components/MailIllustration.astro';
import { copy, type Locale } from '../data/i18n';
import { team } from '../data/team';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale].contact;
---
<div class="contact-layout container">
  <section class="contact-intro enter"><h1>{t.title[0]}</h1><p class="page-lead">{t.intro}</p><button class="mirror-trigger" id="puzzle-mirror" data-escape-puzzle="mirror" disabled aria-haspopup="dialog" aria-label={locale === 'ko' ? '봉투 속 편지 열어보기' : 'Open the letter in the envelope'}><MailIllustration /></button></section>
  <div class="contact-content enter enter--2">
    <section class="contact-channel" aria-labelledby="channel-heading"><h2 id="channel-heading">{t.channel}</h2>
      {team.email ? <><a class="email-address" href={`mailto:${team.email}`}>{team.email}</a><div class="contact-actions"><a class="text-link" href={`mailto:${team.email}`}>{t.write}<Arrow /></a><button class="copy-button" data-copy={team.email} data-copied={t.copied} data-error={t.copyError}>{t.copy}</button></div><p class="copy-feedback" data-copy-feedback role="status"></p></> : <p class="channel-pending">{t.unavailable}</p>}
    </section>
    <section class="contact-topics" aria-labelledby="topics-heading"><h2 id="topics-heading">{t.topics}</h2><dl>{t.topicList.map(([title, description]) => <div><dt>{title}</dt><dd>{description}</dd></div>)}</dl></section>
    <section class="contact-social" aria-labelledby="social-heading"><h2 id="social-heading">{t.elsewhere}</h2><a href={team.ctftime} target="_blank" rel="noopener noreferrer">CTFtime<span>dda_com<Arrow /></span></a>{team.github && <a href={team.github} target="_blank" rel="noopener noreferrer">GitHub<Arrow /></a>}</section>
  </div>
</div>
