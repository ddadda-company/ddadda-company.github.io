---
import Arrow from '../components/Arrow.astro';
import CaptureFlag from '../components/CaptureFlag.astro';
import HomeHonors from '../components/HomeHonors.astro';
import { copy, pageUrl, type Locale } from '../data/i18n';
import { team } from '../data/team';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const ko = locale === 'ko';
---
<section class="open-hero" aria-labelledby="hero-heading" data-scene>
  <div class="open-hero-inner container">
    <div class="open-hero-copy">
      <h1 id="hero-heading">{team.name}<span>{team.koreanName} · {ko ? 'CTF 팀' : 'CTF Team'}</span></h1>
      <p class="hero-alias">{t.home.greeting}</p>
      <p>{t.home.lead}</p>
      <div class="hero-links"><a class="studio-button" href={pageUrl(locale, 'achievements')}>{t.home.recordsLink}<Arrow /></a><a class="text-link" href={pageUrl(locale, 'members')}>{locale === 'ko' ? '멤버 소개' : 'Our members'}<Arrow /></a></div>
    </div>
    <figure class="open-hero-art" data-scene-image><img src="/images/team-object-v2.webp" alt={locale === 'ko' ? '따따의 곰 캐릭터와 분홍색·파란색 D, 키보드와 깃발을 표현한 입체 일러스트' : 'dda_com bear mascots with rose quartz and serenity D emblems, keyboards and CTF flags'} width="1600" height="900" fetchpriority="high" /></figure>
  </div>
</section>
<HomeHonors locale={locale} />
<section class="home-profile container" aria-labelledby="home-profile-heading">
  <h2 id="home-profile-heading">{ko ? '따따의 공식 채널' : 'Official team profiles'}</h2>
  <p>{ko ? '따따의 영문 팀명은 dda_com입니다. ' : 'dda_com is the English name of 따따. '}
    <a href={team.ctftime} target="_blank" rel="noopener noreferrer">{ko ? 'CTFtime의 따따 프로필' : 'Our 따따 profile on CTFtime'}</a>{ko
      ? `에 ${team.alternateNames.join('과 ')}이 같은 팀의 다른 이름으로 등록되어 있습니다.`
      : ` lists ${team.alternateNames.join(' and ')} as names for the same team.`}
  </p>
  <p>{ko ? '팀의 공개 저장소는 ' : 'Find our public repositories on '}
    <a href={team.github} target="_blank" rel="noopener noreferrer">GitHub · ddadda-company</a>{ko ? '에서 확인할 수 있습니다. 대회 초청과 협업은 ' : '. For competition invitations and collaboration, visit our '}
    <a href={pageUrl(locale, 'contact')}>{ko ? '공식 연락처' : 'contact page'}</a>{ko ? '로 문의해 주세요.' : '.'}
  </p>
</section>
<CaptureFlag locale={locale} />

<style>
  .open-hero-copy > .hero-alias { margin-top: 8px; font-size: .875rem; }
  .home-profile { padding-block: 24px clamp(36px, 5vw, 72px); }
  .home-profile h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .home-profile p { max-width: 760px; margin-top: 16px; color: var(--color-ink-soft); line-height: 1.8; word-break: keep-all; overflow-wrap: anywhere; }
  .home-profile a { color: var(--color-ink); text-decoration: underline; text-underline-offset: .2em; }
</style>
