---
import Arrow from '../components/Arrow.astro';
import CaptureFlag from '../components/CaptureFlag.astro';
import { copy, pageUrl, type Locale } from '../data/i18n';
import { achievements, members, team } from '../data/team';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const ko = locale === 'ko';
---
<section class="open-hero" aria-labelledby="hero-heading" data-scene>
  <div class="open-hero-inner container">
    <div class="open-hero-copy">
      <h1 id="hero-heading">{team.name}<span>{team.koreanName} · {ko ? 'CTF 팀' : 'CTF Team'}</span></h1>
      <p class="hero-alias">{t.home.greeting}</p>
      <p>{t.home.lead}</p>
      <div class="hero-links"><a class="studio-button" href={pageUrl(locale, 'achievements')}>{t.home.recordsLink}<Arrow /></a><a class="text-link" href={pageUrl(locale, 'members')}>{locale === 'ko' ? '멤버 소개' : 'Our members'}<Arrow /></a></div>
    </div>
    <figure class="open-hero-art" data-scene-image><img src="/images/team-object-v2.webp" alt={locale === 'ko' ? '따따의 곰 캐릭터와 분홍색·파란색 D, 키보드와 깃발을 표현한 입체 일러스트' : 'dda_com bear mascots with rose quartz and serenity D emblems, keyboards and CTF flags'} width="1600" height="900" fetchpriority="high" /></figure>
  </div>
</section>
<section class="home-records container" aria-labelledby="home-records-heading">
  <div class="home-records-heading">
    <h2 id="home-records-heading">{ko ? '따따의 대회 기록' : 'dda_com in competition'}</h2>
    <p>{ko
      ? `${members.length}명의 멤버가 함께하는 따따의 CTF 대회 활동입니다. 대회 성과 페이지에서 팀·개인·연합팀으로 참가한 ${achievements.length}건의 기록과 스코어보드, 결과 출처를 확인할 수 있습니다.`
      : `Meet our ${members.length} members and explore ${achievements.length} competition records, covering team, individual and coalition entries. The results archive includes scoreboards and supporting sources.`}</p>
  </div>
  <ul class="home-record-list">
    {achievements.filter(record => record.featured).map(record => <li>
      <time datetime={record.date}>{record.date}</time>
      <h3>{record.event}</h3>
      <p><strong>{record.placement[locale]}</strong> · {record.description?.[locale]}</p>
      <a class="text-link" href={record.url} target="_blank" rel="noopener noreferrer" aria-label={`${record.event} · ${ko ? '결과 출처' : 'Result source'}`}>{ko ? '결과 출처' : 'Result source'}<Arrow /></a>
    </li>)}
  </ul>
  <a class="text-link" href={pageUrl(locale, 'achievements')}>{ko ? '대회 기록 전체 보기' : 'Explore all competition results'}<Arrow /></a>
</section>
<CaptureFlag locale={locale} />

<style>
  .open-hero-copy > .hero-alias { margin-top: 8px; font-size: .875rem; }
  .home-records { padding-block: clamp(36px, 5vw, 72px); }
  .home-records-heading { max-width: 760px; }
  .home-records-heading h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .home-records-heading p { margin-top: 16px; color: var(--color-ink-soft); line-height: 1.8; word-break: keep-all; overflow-wrap: anywhere; }
  .home-record-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; padding: 0; margin-block: 28px; list-style: none; }
  .home-record-list li { border-top: 1px solid var(--color-ink-soft); padding-top: 20px; }
  .home-record-list time { font-size: .75rem; color: var(--color-muted); }
  .home-record-list h3 { margin-block: 12px; font-size: 1.125rem; line-height: 1.5; }
  .home-record-list p { font-size: .875rem; line-height: 1.8; word-break: keep-all; overflow-wrap: anywhere; }
  .home-record-list .text-link { margin-top: 12px; }
  @media (max-width: 47.99rem) { .home-record-list { grid-template-columns: 1fr; gap: 24px; } }
</style>
