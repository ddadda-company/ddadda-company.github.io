---
import Arrow from './Arrow.astro';
import { invisibleFlag } from '../data/escape';
import { pageUrl, type Locale } from '../data/i18n';
import '../styles/capture-flag.css';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---
<section class="capture-section" aria-labelledby="capture-heading">
  <div class="capture-layout container">
    <div class="capture-copy">
      <h2 id="capture-heading">Capture <br />the flag<span>.</span></h2>
      <div class="capture-secret" data-secret data-nosnippet>
        <code id="trace" class="capture-secret-flag" data-secret-flag tabindex="0">{invisibleFlag}</code>
        <div class="capture-result-actions" data-secret-actions hidden>
          <button data-secret-copy data-flag={invisibleFlag} data-copied={ko ? '복사했어요' : 'Copied'} data-copy-error={ko ? '복사하지 못했습니다. 플래그를 선택해 복사해 주세요.' : 'Could not copy. Select the flag to copy it.'}>{ko ? '플래그 복사' : 'Copy flag'}</button>
        </div>
        <p class="visually-hidden" data-secret-status role="status" data-success={ko ? '플래그를 찾았습니다.' : 'Flag found.'}></p>
      </div>
      <nav class="capture-links" aria-label={ko ? '따따 더 알아보기' : 'Explore dda_com'}>
        <a href={pageUrl(locale, 'achievements')}>{ko ? '대회 기록' : 'Competition record'}<Arrow /></a>
        <a href={pageUrl(locale, 'members')}>{ko ? '팀 멤버' : 'Team members'}<Arrow /></a>
      </nav>
    </div>
    <div class="capture-field">
      <img class="capture-props" src="/images/capture-props.webp" width="1200" height="800" alt="" loading="lazy" />
      <div class="capture-puzzle-map">
        <button class="capture-hotspot capture-hotspot--keyboard" id="puzzle-keyboard" data-escape-puzzle="keyboard" hidden aria-haspopup="dialog"><span>{ko ? '키보드 살펴보기' : 'Inspect keyboard'}</span></button>
        <button class="capture-hotspot capture-hotspot--binary" id="puzzle-binary" data-escape-puzzle="binary" hidden aria-haspopup="dialog"><span>{ko ? '자물쇠 살펴보기' : 'Inspect padlock'}</span></button>
      </div>
      <button class="capture-piece" id="puzzle-capture" data-escape-puzzle="capture" disabled aria-haspopup="dialog" aria-label={ko ? '깃발 살펴보기' : 'Inspect flag'}>
        <img src="/images/capture-toy-flag.webp" width="720" height="960" alt="" loading="lazy" draggable="false" />
      </button>
    </div>
  </div>
</section>
<script src="../scripts/capture-flag.ts"></script>
