---
import type { Locale } from '../data/i18n';
import { memberSurprisePhotos } from '../data/member-surprise';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---
{memberSurprisePhotos.length > 0 && <dialog id="member-surprise" class="member-surprise" aria-label={ko ? '깜짝 사진' : 'Surprise photo'} data-photos={JSON.stringify(memberSurprisePhotos)} data-nosnippet>
  <img data-surprise-photo alt={ko ? '깜짝 등장한 사진' : 'A surprise photo'} />
  <p class="surprise-discovery" data-surprise-discovery></p>
  <button type="button" data-surprise-close autofocus aria-label={ko ? '닫기' : 'Close'}>×</button>
</dialog>}
<style is:global>
  .member-surprise-trigger { appearance: none; padding: 0; border: 0; background: none; color: inherit; font: inherit; letter-spacing: inherit; text-align: inherit; cursor: pointer; }
  .member-surprise-trigger:focus-visible { outline: 3px solid currentColor; outline-offset: 6px; }
  .member-surprise { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #090909; overflow: hidden; cursor: pointer; }
  .member-surprise::backdrop { background: #090909; }
  .member-surprise[open] { display: grid; place-items: center; }
  .member-surprise img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .member-surprise[open] img { transform-origin: 50% 40%; animation: member-surprise-lunge 420ms linear both; }
  .member-surprise [data-surprise-close] { position: absolute; z-index: 1; top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); width: 48px; height: 48px; padding: 0; border: 1px solid #ffffff80; border-radius: 50%; background: #000a; color: #fff; font-size: 32px; cursor: pointer; }
  html:has(.member-surprise[open]) { overflow: hidden; }
  @keyframes member-surprise-lunge {
    0% { transform: scale(.82); }
    14% { transform: scale(1.6) rotate(-2deg); }
    27% { transform: translate(2%, -1%) scale(1.5) rotate(2deg); }
    40% { transform: translate(-2%, 1%) scale(1.4) rotate(-1.5deg); }
    54% { transform: translate(1%, -.5%) scale(1.28) rotate(1deg); }
    70% { transform: translate(-.5%, 0) scale(1.12) rotate(-.5deg); }
    100% { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .member-surprise[open] img { animation: none; }
  }
</style>
<script src="../scripts/member-surprise.ts"></script>
