---
import type { Locale } from '../data/i18n';
interface Props { rank: number; locale: Locale; size?: 'regular' | 'honor'; }
const { rank, locale, size = 'regular' } = Astro.props;
const suffix = locale === 'ko' ? '위' : rank % 100 >= 11 && rank % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[rank % 10] ?? 'th');
---
<span class:list={['rank-badge', `rank-badge--${size}`, { 'rank-badge--podium': rank <= 3, 'rank-badge--first': rank === 1, 'rank-badge--second': rank === 2, 'rank-badge--third': rank === 3 }]} role="img" aria-label={`${rank}${suffix}`}>
  <span class="rank-value" aria-hidden="true"><strong>{rank}</strong><small>{suffix}</small></span>
</span>
