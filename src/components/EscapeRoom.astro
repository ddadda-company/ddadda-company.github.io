---
import { flags } from '../data/escape';
import { pageUrl, type Locale } from '../data/i18n';
import materials from '../data/challenge-materials.json';
import '../styles/escape-room.css';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---
<dialog class="escape-dialog" data-escape-dialog aria-labelledby="escape-title">
  <div class="escape-sheet" data-nosnippet>
    <div class="escape-heading">
      <h2 id="escape-title" tabindex="-1"></h2>
      <button class="escape-close" data-escape-close aria-label={ko ? '닫기' : 'Close'}>×</button>
    </div>
    <div data-escape-collection hidden>
      <p class="escape-intro" data-collection-summary></p>
      <button class="escape-button escape-button--primary" data-replay-finale hidden>{ko ? '탈출 장면 다시 보기' : 'Replay your escape'}</button>
      <ol class="flag-collection">
        {flags.map(flag => <li data-collection-item={flag.id}>
          <span class="collection-mark" aria-hidden="true">?</span>
          <div><h3>{flag.title[locale]}</h3>
            <a class="collection-clue" data-collection-clue href={`${pageUrl(locale, flag.page)}#${flag.anchor}`}>{flag.location[locale]} <span aria-hidden="true">↗</span></a>
            <code data-collection-code hidden></code>
          </div>
          <button class="escape-button" data-collection-copy={flag.id} hidden>{ko ? '복사' : 'Copy'}</button>
        </li>)}
      </ol>
    </div>
    <section class="challenge-room" data-challenge-room hidden>
      <p class="escape-intro" data-challenge-description></p>
      <div class="challenge-materials">
        {Object.entries(materials).map(([id, entries]) => <div data-materials-for={id} hidden>
          {entries.map((material, index) => <details class="challenge-material" name={`materials-${id}`} open={index === 0}>
            <summary>{material.label}</summary>
            <div class="material-actions"><button class="escape-button" data-material-copy={`material-${id}-${index}`} aria-label={ko ? `${material.label} 복사` : `Copy ${material.label}`}>{ko ? '복사' : 'Copy'}</button></div>
            <pre tabindex="0" aria-label={`${material.label}, ${material.language}`}><code id={`material-${id}-${index}`}>{typeof material.content === 'string' ? material.content : material.content[locale]}</code></pre>
          </details>)}
        </div>)}
      </div>
      <form class="challenge-submit" data-challenge-form>
        <label for="challenge-answer">{ko ? '플래그 제출' : 'Submit a flag'}</label>
        <div class="challenge-input-row"><input id="challenge-answer" name="flag" type="text" placeholder="dda{...}" autocomplete="off" autocapitalize="off" spellcheck="false" required maxlength="133" aria-errormessage="escape-feedback" /><button class="escape-button escape-button--primary" type="submit" data-challenge-submit>{ko ? '제출' : 'Submit'}</button></div>
      </form>
    </section>
    <div class="escape-solved" data-escape-solved hidden>
      <p>{ko ? '플래그 확보' : 'Flag captured'}</p>
      <code data-escape-flag></code>
      <div class="escape-actions"><button class="escape-button" data-escape-copy>{ko ? '플래그 복사' : 'Copy flag'}</button><button class="escape-button" data-open-collection>{ko ? '수집함' : 'Your flags'}</button></div>
    </div>
    <section class="escape-finale" data-escape-finale hidden aria-labelledby="finale-heading">
      <div class="finale-burst" data-finale-burst aria-hidden="true"></div>
      <div class="finale-vault" aria-hidden="true"><span class="vault-door vault-door--left"></span><span class="vault-door vault-door--right"></span><span class="finale-flag"><svg viewBox="0 0 100 120" fill="none"><path d="M22 113V9" stroke="currentColor" stroke-width="7" stroke-linecap="round"/><path d="M27 13C49 0 61 31 89 16V69C61 84 49 53 27 66Z" fill="currentColor"/></svg></span></div>
      <p class="finale-count">7 / 7</p>
      <h3 id="finale-heading">ALL FLAGS<br />CAPTURED.</h3>
      <p class="finale-message">{ko ? '따따의 숨은 플래그를 모두 확보했습니다.' : 'Every hidden flag in dda_com is yours.'}</p>
      <div class="escape-actions"><button class="escape-button escape-button--primary" data-open-collection>{ko ? '수집함 보기' : 'View your flags'}</button><button class="escape-button" data-finale-again>{ko ? '한 번 더' : 'Play it again'}</button></div>
    </section>
    <p id="escape-feedback" class="escape-feedback visually-hidden" data-escape-feedback role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</dialog>
<script src="../scripts/escape-room.ts"></script>
