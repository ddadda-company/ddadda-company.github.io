---
import Arrow from './Arrow.astro';
import { pageUrl, type Locale } from '../data/i18n';
import type { Member } from '../data/team';
interface Props { member: Member; locale: Locale; index: number; compact?: boolean; }
const { member, locale, index, compact = false } = Astro.props;
const profileAnchor = `member-${member.handle}`;
const githubPath = 'M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.06c-3.09.67-3.74-1.31-3.74-1.31-.51-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.92.1-.72.39-1.2.71-1.48-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.14-2.98-.12-.28-.49-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.04-1.14 3.04-1.14.61 1.53.23 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.61 5.2-5.1 5.48.4.35.76 1.02.76 2.06v3.03c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z';
const links = [
  { name: 'GitHub', href: member.github, icon: 'github' },
  { name: locale === 'ko' ? '이메일' : 'Email', href: member.email ? `mailto:${member.email}` : undefined, icon: 'email' },
];
---
<article class:list={['member-profile', 'member-card', 'member-gallery-profile', `member-card--${index % 7}`]} id={compact ? undefined : profileAnchor} data-member data-disciplines={member.disciplines.join(',')} aria-labelledby={`${profileAnchor}-name`}>
  <div class="member-portrait-stage" data-tilt>
    <div class:list={['member-photo', { 'member-photo--empty': !member.photo }]}>
      {member.photo ? <img src={member.photo} alt="" width="600" height="600" loading="lazy" /> : <>
        <!-- Replace by setting member.photo in src/data/team.ts; portrait target: 600 × 600. -->
        <div class="member-monogram" aria-hidden="true"><span>{member.handle.slice(0, 1)}</span></div>
        <span class="visually-hidden">{locale === 'ko' ? '프로필 사진 미등록' : 'No profile photo yet'}</span>
      </>}
    </div>
    {member.role && <span class="member-gallery-role">{member.role[locale]}</span>}
  </div>
  <div class="member-info"><h3 id={`${profileAnchor}-name`}>{compact ? <a href={`${pageUrl(locale, 'members')}#${profileAnchor}`}>{member.handle}</a> : member.handle}</h3></div>
  <div class:list={['member-biography', { 'member-biography--empty': !member.bio[locale] }]} aria-hidden={!member.bio[locale] ? 'true' : undefined}>{member.bio[locale] && <p>{member.bio[locale]}</p>}</div>
  {member.disciplines.length > 0 && <p class="member-card-fields">{member.disciplines.join(' · ')}</p>}
  <div class="member-contacts">
    {links.map(link => {
      const Tag = link.href ? 'a' : 'span';
      return <Tag class:list={['member-contact', { 'member-contact--pending': !link.href }]} href={link.href} target={link.href && link.icon === 'github' ? '_blank' : undefined} rel={link.href && link.icon === 'github' ? 'noopener noreferrer' : undefined} aria-disabled={!link.href ? 'true' : undefined} title={!link.href ? (locale === 'ko' ? '아직 공개된 주소가 없습니다' : 'Not shared yet') : undefined}>
        <span class="member-contact-icon">{link.icon === 'github' ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={githubPath} fill="currentColor"/></svg> : <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}</span>
        <span>{link.name}</span>{link.href && <Arrow />}
      </Tag>;
    })}
    {member.url && <a class="member-contact" href={member.url} target="_blank" rel="noopener noreferrer">{locale === 'ko' ? '웹사이트' : 'Website'}<Arrow /></a>}
  </div>
</article>
