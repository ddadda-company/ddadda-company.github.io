---
import type { Locale } from '../data/i18n';
import { memberSurprisePhotos } from '../data/member-surprise';
import '../styles/member-collection.css';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---
{memberSurprisePhotos.length > 0 && <>
  <div class="surprise-collection-entry" hidden data-surprise-entry data-nosnippet>
    <button type="button" class="surprise-collection-trigger" data-surprise-collection-open aria-haspopup="dialog" aria-controls="surprise-collection">
      <svg class="surprise-collection-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 5v15M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Z" /></svg>
      <span><small>{ko ? '스페셜 퀘스트' : 'Special quest'}</small><span>{ko ? '사진 도감' : 'Photo collection'}</span></span>
      <strong data-surprise-count>0/{memberSurprisePhotos.length}</strong>
    </button>
  </div>
  <p class="visually-hidden" data-surprise-status role="status" aria-live="polite" aria-atomic="true"></p>
</>}
{memberSurprisePhotos.length > 0 && <dialog id="surprise-collection" class="surprise-collection" aria-labelledby="surprise-collection-title" data-photos={JSON.stringify(memberSurprisePhotos)} data-nosnippet>
  <header class="surprise-collection-header">
    <div><p class="surprise-collection-owner">8l4nk</p><h2 id="surprise-collection-title">{ko ? '사진 도감' : 'Photo collection'}</h2></div>
    <button type="button" class="surprise-collection-close" data-collection-close autofocus aria-label={ko ? '도감 닫기' : 'Close collection'}>×</button>
  </header>
  <div class="surprise-collection-body">
    <div class="surprise-collection-progress"><div class="surprise-collection-stamps" aria-hidden="true">{memberSurprisePhotos.map(src => <span data-collection-stamp={src}>★</span>)}</div><strong data-surprise-count>0/{memberSurprisePhotos.length}</strong><progress class="visually-hidden" data-collection-progress value="0" max={memberSurprisePhotos.length} aria-label={ko ? '사진 수집 진행률' : 'Photo collection progress'}></progress></div>
    <p class="surprise-collection-instruction">{ko ? '8l4nk 프로필을 누르면 만난 사진이 등록돼요.' : 'Click the 8l4nk profile to discover and collect photos.'}</p>
    <p class="surprise-collection-complete" data-collection-complete hidden>{ko ? '전부 모았다! 도감 완성 🎉' : 'Found them all! Collection complete 🎉'}</p>
    <div class="surprise-album-pages">
    <div class="surprise-collection-grid">
      {memberSurprisePhotos.map((src, index) => <button type="button" class="surprise-collection-slot" data-collection-photo={src} disabled aria-pressed="false" aria-label={ko ? `사진 ${index + 1} · 미발견` : `Photo ${index + 1} · Undiscovered`}>
        <span class="surprise-collection-thumbnail"><span class="surprise-mystery" data-collection-lock aria-hidden="true">?</span><img data-collection-thumbnail alt="" width="240" height="180" hidden /></span>
        <span class="surprise-collection-caption"><span>{String(index + 1).padStart(2, '0')}</span><span data-collection-label>{ko ? '미발견' : 'Not found'}</span></span>
      </button>)}
    </div>
    <figure class="surprise-collection-detail" data-collection-detail hidden><div class="surprise-photo-sleeve"><img data-collection-full-photo alt="" /><p data-collection-image-status role="status" hidden></p><button type="button" class="surprise-photo-retry" data-collection-retry hidden>{ko ? '다시 불러오기' : 'Try again'}</button></div><figcaption><span data-collection-detail-caption></span><span class="surprise-photo-sticker" aria-hidden="true">♥</span></figcaption></figure>
    </div>
    <p class="surprise-collection-storage" data-collection-storage hidden>{ko ? '이 브라우저에서 저장할 수 없어 이번 페이지에서만 수집 기록이 유지돼요.' : 'Storage is unavailable. Your collection will last only on this page.'}</p>
  </div>
</dialog>}
<script src="../scripts/member-collection.ts"></script>
