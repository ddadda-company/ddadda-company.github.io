---
import { achievements } from '../data/team';
import type { Locale } from '../data/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const records = [...achievements].reverse();
const points = records.map((record, i) => ({ ...record, x: 34 + i * 48, y: 30 + (record.rank - 1) * 11 }));
const line = points.map((p, i) => `${i ? 'L' : 'M'} ${p.x} ${p.y}`).join(' ');
---
<figure class="rank-chart">
  <figcaption><span>{locale === 'ko' ? '대회별 순위' : 'Competition placements'}</span><span>2026</span></figcaption>
  <svg viewBox="0 0 500 208" role="img" aria-label={locale === 'ko' ? '2026년 10개 대회의 순위를 시간순으로 표시한 그래프. 상세 결과는 대회 목록에서 확인할 수 있습니다.' : 'Placements across ten 2026 competitions, in chronological order. The competition list provides detailed results.'}>
    {[1, 5, 10].map(rank => <g class="chart-grid"><line x1="34" y1={30 + (rank - 1) * 11} x2="466" y2={30 + (rank - 1) * 11} /><text x="3" y={34 + (rank - 1) * 11}>{rank}</text></g>)}
    <path class="chart-line" d={line} pathLength="1" />
    {points.map(p => <g><circle class:list={['chart-node', { 'chart-node--winner': p.rank === 1 }]} cx={p.x} cy={p.y} r={p.rank === 1 ? 6 : 4}><title>{p.event}: {p.placement[locale]}</title></circle><text class="chart-index" x={p.x} y="187" text-anchor="middle">{p.rank}</text></g>)}
    <text class="chart-axis" x="34" y="207">{locale === 'ko' ? '이전 대회' : 'Earlier events'}</text><text class="chart-axis" x="466" y="207" text-anchor="end">{locale === 'ko' ? '최근 대회' : 'Recent events'}</text>
  </svg>
  <div class="chart-legend"><span><i></i>{locale === 'ko' ? '대회 순위' : 'Placement'}</span><span><i></i>{locale === 'ko' ? '우승' : 'First place'}</span></div>
</figure>
