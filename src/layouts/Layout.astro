---
import { copy, pages, pageUrl, type Locale, type Page } from '../data/i18n';
import { team } from '../data/team';
import { absoluteUrl, languageAlternates, pageSchema, serializeJsonLd, socialImage } from '../lib/seo';
import Arrow from '../components/Arrow.astro';
import EscapeRoom from '../components/EscapeRoom.astro';
import '../../tokens.css';
import '../styles/global.css';
import '../styles/studio.css';
import '../styles/chrome.css';
import '../styles/mobile.css';
interface Props { locale: Locale; page: Page; title?: string; description?: string; noindex?: boolean; }
const { locale, page, title, description: customDescription, noindex = false } = Astro.props;
const t = copy[locale];
const pageTitle = title ?? t.meta[page];
const description = customDescription ?? t.meta.description[page];
const canonicalUrl = absoluteUrl(pageUrl(locale, page), Astro.site);
const shareImage = absoluteUrl(socialImage.path, Astro.site);
const verificationTags = [
  ['google-site-verification', import.meta.env.GOOGLE_SITE_VERIFICATION],
  ['naver-site-verification', import.meta.env.NAVER_SITE_VERIFICATION],
  ['msvalidate.01', import.meta.env.BING_SITE_VERIFICATION],
].filter(([, value]) => typeof value === 'string' && value.trim());
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && verificationTags.map(([name, content]) => <meta name={name} content={content} />)}
    <meta name="theme-color" content="#f7cac9" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={team.siteName} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:alt" content={t.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={t.imageAlt} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    {!noindex && <meta property="og:locale:alternate" content={locale === 'ko' ? 'en_US' : 'ko_KR'} />}
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {!noindex && languageAlternates(page, Astro.site).map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
    {!noindex && <script type="application/ld+json" is:inline set:html={serializeJsonLd(pageSchema(locale, page, Astro.site))} />}
    <link rel="preload" href="/fonts/Paperlogy-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/WantedSansVariable.woff2" as="font" type="font/woff2" crossorigin />
    {page === 'home' && <link rel="preload" href="/fonts/Fraunces-Soft-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />}
    <title>{pageTitle}</title>
  </head>
  <body data-page={page} class="identity-v3">
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header" id="top">
      <div class="header-inner container">
        <a class="brand" href={pageUrl(locale, 'home')} aria-label={t.meta.home}>
          <img class="brand-icon" src="/favicon.svg" width="32" height="32" alt="" />
          <span class="brand-name">dda_com</span>
        </a>
        <nav class="studio-nav" aria-label={t.navigation}>{pages.map(p => <a href={pageUrl(locale, p)} aria-current={page === p ? 'page' : undefined}>{t.nav[p]}</a>)}</nav>
        <div class="header-actions">
          <nav class="language-switch" aria-label={t.language}>
            <a href={pageUrl('ko', page)} data-language="ko" aria-current={locale === 'ko' ? 'true' : undefined} aria-label="한국어" lang="ko">KO</a>
            <span aria-hidden="true">/</span>
            <a href={pageUrl('en', page)} data-language="en" aria-current={locale === 'en' ? 'true' : undefined} aria-label="English" lang="en">EN</a>
          </nav>
          <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" data-open-label={t.menu} data-close-label={t.close}><span data-menu-label>{t.menu}</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
        </div>
      </div>
      <nav class="mobile-nav container" id="mobile-nav" aria-label={t.navigation} hidden>
        {pages.map(p => <a href={pageUrl(locale, p)} aria-current={page === p ? 'page' : undefined}>{t.nav[p]}<Arrow /></a>)}
      </nav>
      <noscript><nav class="no-js-nav container" aria-label={t.navigation}>{pages.map(p => <a href={pageUrl(locale, p)}>{t.nav[p]}</a>)}</nav></noscript>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <div class="footer-identity"><a class="footer-wordmark" href={pageUrl(locale, 'home')}><img src="/favicon.svg" width="44" height="44" alt="" />dda_com</a></div>
          <nav class="footer-nav" aria-label={locale === 'ko' ? '팀 링크' : 'Team links'}>
            <a href={team.github} target="_blank" rel="noopener noreferrer">GitHub<Arrow /></a>
            <a href={team.ctftime} target="_blank" rel="noopener noreferrer">CTFtime<Arrow /></a>
            <a href={pageUrl(locale, 'contact')}>{t.nav.contact}<Arrow /></a>
          </nav>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} dda_com CTF TEAM</span>
          <button class="flag-collection-trigger" data-open-collection hidden>{locale === 'ko' ? '숨은 플래그' : 'Hidden flags'} <strong data-flag-count>0/7</strong></button>
          <div><a href="#top">{t.top}<Arrow direction="up-right" /></a></div>
        </div>
      </div>
    </footer>
    <EscapeRoom locale={locale} />
    <script src="../scripts/main.ts"></script>
    <script src="../scripts/studio.ts"></script>
  </body>
</html>
